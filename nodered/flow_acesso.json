[
  {
    "id": "tab_controle_acesso",
    "type": "tab",
    "label": "Controle de Acesso",
    "disabled": false,
    "info": "Fluxo principal: recebe evento RFID via MQTT, valida permissão no Flask e registra o log."
  },
  {
    "id": "mqtt_in_catraca",
    "type": "mqtt in",
    "z": "tab_controle_acesso",
    "name": "catraca/acesso",
    "topic": "catraca/acesso",
    "qos": "1",
    "datatype": "json",
    "broker": "broker_mosquitto",
    "nl": false,
    "rap": false,
    "rh": 0,
    "x": 120,
    "y": 100,
    "wires": [["fn_prepara_url"]]
  },
  {
    "id": "fn_prepara_url",
    "type": "function",
    "z": "tab_controle_acesso",
    "name": "Prepara URL de consulta",
    "func": "msg.url = \"http://localhost:5000/api/acesso/\" + msg.payload.uid.replace(/ /g, \"%20\");\nmsg.uid_original = msg.payload.uid;\nmsg.tipo = msg.payload.tipo;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "x": 340,
    "y": 100,
    "wires": [["http_consulta_flask"]]
  },
  {
    "id": "http_consulta_flask",
    "type": "http request",
    "z": "tab_controle_acesso",
    "name": "GET /api/acesso/{uid}",
    "method": "GET",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "",
    "tls": "",
    "persist": false,
    "proxy": "",
    "authType": "",
    "x": 580,
    "y": 100,
    "wires": [["fn_processa_resposta"]]
  },
  {
    "id": "fn_processa_resposta",
    "type": "function",
    "z": "tab_controle_acesso",
    "name": "Processa resposta e prepara registro",
    "func": "// Payload de resposta para o ESP32\nmsg.resposta_esp = {\n    autorizado: msg.payload.autorizado,\n    nome: msg.payload.nome || \"Desconhecido\",\n    motivo: msg.payload.motivo || \"\"\n};\n\n// Payload para registrar no banco via Flask\nmsg.registro = {\n    uid_cartao: msg.uid_original,\n    nome_funcionario: msg.payload.nome || \"Desconhecido\",\n    tipo: msg.tipo,\n    autorizado: msg.payload.autorizado\n};\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "x": 820,
    "y": 100,
    "wires": [["mqtt_out_resposta", "fn_prepara_registro"]]
  },
  {
    "id": "mqtt_out_resposta",
    "type": "mqtt out",
    "z": "tab_controle_acesso",
    "name": "catraca/resposta",
    "topic": "catraca/resposta",
    "qos": "1",
    "retain": false,
    "respTopic": "",
    "contentType": "",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "broker_mosquitto",
    "x": 1080,
    "y": 60,
    "wires": []
  },
  {
    "id": "fn_prepara_registro",
    "type": "function",
    "z": "tab_controle_acesso",
    "name": "Prepara POST de registro",
    "func": "msg.payload = msg.registro;\nmsg.headers = { \"Content-Type\": \"application/json\" };\nmsg.url = \"http://localhost:5000/api/acesso/registrar\";\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "x": 1080,
    "y": 140,
    "wires": [["http_registrar_log"]]
  },
  {
    "id": "http_registrar_log",
    "type": "http request",
    "z": "tab_controle_acesso",
    "name": "POST /api/acesso/registrar",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "http://localhost:5000/api/acesso/registrar",
    "tls": "",
    "persist": false,
    "proxy": "",
    "authType": "",
    "x": 1320,
    "y": 140,
    "wires": [["debug_log_registrado"]]
  },
  {
    "id": "debug_log_registrado",
    "type": "debug",
    "z": "tab_controle_acesso",
    "name": "Log registrado",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 1540,
    "y": 140,
    "wires": []
  },
  {
    "id": "broker_mosquitto",
    "type": "mqtt-broker",
    "name": "Mosquitto Local",
    "broker": "localhost",
    "port": "1883",
    "clientid": "nodered_acesso",
    "autoConnect": true,
    "usetls": false,
